# --- Core / server ---
NODE_ENV=development
APP_PORT=3006
APP_HOST=http://localhost:3006
APP_ORG_ID=1
ADMIN_WEB_URL=http://localhost:3100
RUN_WORKERS_IN_WEB=true

# --- Database ---
DATABASE_URL=
DATABASE_SSL=
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_APP_NAME=

# --- Security ---
# Must be 32 bytes base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRYPTO_KEY_BASE64=GENERATE_32B_BASE64
CSRF_SECRET=CHANGE_ME_LONG_RANDOM

# --- Admin auth ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Shopify OAuth / API ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_products,write_products,read_customers,write_customers,read_inventory,write_inventory
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=
SHOPIFY_VENDOR=

# --- Alegra ---
ALEGRA_TIMEOUT_MS=30000

# --- Sync pollers ---
ORDERS_SYNC_POLL_SECONDS=
ORDERS_SYNC_POLL_MS=
ORDERS_SYNC_BATCH_SIZE=
ORDERS_SYNC_MAX_ORDERS=
ORDERS_SYNC_LOOKBACK_MINUTES=

PRODUCTS_SYNC_POLL_SECONDS=
PRODUCTS_SYNC_POLL_MS=
PRODUCTS_SYNC_BATCH_SIZE=
PRODUCTS_SYNC_BATCH_LIMIT=
PRODUCTS_SYNC_LOOKBACK_MINUTES=

RETRY_QUEUE_POLL_MS=
RETRY_QUEUE_MAX_RETRIES=
RETRY_QUEUE_BASE_DELAY_SEC=

# --- Inventory adjustments ---
INVENTORY_ADJUSTMENTS_POLL_DISABLED=

# --- Billing report ---
BILLING_REPORT_ENABLED=true
BILLING_REPORT_CRON=5 0 1 * *
BILLING_REPORT_TZ=America/Bogota
BILLING_REPORT_TO=
BILLING_REPORT_WEBHOOK_URL=

# --- Metrics ---
METRICS_MAX_PAGES=10
METRICS_TIMEOUT_MS=8000
METRICS_SHOPIFY_MAX_ORDERS=500
METRICS_INVENTORY_SALES_DAYS=30

# Required for queues/cron
REDIS_URL=redis://HOST:6379

# Canal externo para alertas operativas (Slack/Teams/n8n/Make o receptor HTTP).
# El monitor envía JSON y marca su pasada como fallida si el receptor no responde 2xx.
OPS_ALERT_WEBHOOK_URL=
ALERT_FAILS_PER_HOUR=10
SHOPIFY_RL_MAX_PER_SEC=6
SHOPIFY_RL_MAX_WAIT_MS=15000
SHOPIFY_API_VERSION_MARKETING=2024-10

# --- Webhooks ---
ALEGRA_WEBHOOK_SECRET=
ALLOW_UNVERIFIED_SHOPIFY_WEBHOOKS=

# --- AI Assistant ---
OPENAI_MODEL=gpt-4o-mini

# --- Scripts only (CLI helpers) ---
# Used only by scripts/create-shopify-webhooks.js
WEBHOOK_BASE_URL=
# Used by scripts/qa-smoke.js (puede ser igual a APP_HOST; default: http://localhost:3006)
BASE_URL=
# Token opcional para QA (Bearer), generado por /api/auth/token
QA_TOKEN=
SHOPIFY_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_LOCATION_ID=
SHOP_DOMAIN=

ALEGRA_EMAIL=
ALEGRA_API_KEY=
ALEGRA_WAREHOUSE_ID=
ALEGRA_TAX_ID=
ALEGRA_PRICE_LIST_ID=
ALEGRA_UNIT=
ALEGRA_ITEM_ID=
ALEGRA_QTY=
ALEGRA_UNIT_COST=
ALEGRA_IMAGE_URL=
ALEGRA_REFERENCE=
ALEGRA_ITEMS_JSON=
ALEGRA_VARIANT_ATTRIBUTE_ID=
ALEGRA_VARIANT_ATTRIBUTE_NAME=Talla
XLSX_SHEET=item
XLSX_WAREHOUSE_NAME=Bodega Pagina Web
