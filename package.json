{
  "name": "admin-central-platform",
  "description": "Multi-tenant middleware for Shopify, Alegra, and marketing operations.",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:admin-web": "npm --prefix apps/admin-web run dev",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "build:admin-web": "npm --prefix apps/admin-web run build",
    "start": "node dist/src/server.js",
    "start:workers": "node dist/apps/workers/src/bootstrap.js",
    "start:admin-web": "npm --prefix apps/admin-web run start",
    "db:migrate": "node dist/src/scripts/db-migrate.js",
    "db:migrate:dev": "ts-node-dev --transpile-only --exit-child src/scripts/db-migrate.ts",
    "check:frontend": "node --check public/app.js && node --check public/company.js && node --check public/login.js && node --check public/users.js",
    "typecheck:admin-web": "npm --prefix apps/admin-web run typecheck",
    "qa:smoke": "node scripts/qa-smoke.js",
    "qa:admin-web": "node scripts/qa-admin-web.js",
    "qa:integration": "node scripts/qa-integration-actions.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bullmq": "^5.67.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "graphql": "^16.12.0",
    "graphql-http": "^1.22.4",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.7",
    "ioredis": "^5.9.2",
    "mongodb": "^6.12.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "pg": "^8.11.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  }
}
